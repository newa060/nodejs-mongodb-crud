<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit User</title>

  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body class="bg-gradient-to-br from-slate-900 via-zinc-900 to-slate-800
             min-h-screen text-white">

  <!-- Navbar -->
  <nav class="w-full px-14 py-6 flex justify-between items-center">
    <h1 class="text-2xl font-semibold text-slate-200">
      User Management
    </h1>

    <a href="/read" class="text-slate-300 hover:text-indigo-400 transition">
      View Users
    </a>
  </nav>

  <!-- Main -->
  <main class="flex justify-center mt-24 px-10">

    <div class="w-full max-w-5xl bg-zinc-900/80 backdrop-blur-xl
                rounded-[2.5rem] p-16 shadow-2xl border border-white/5">

      <h2 class="text-4xl font-semibold mb-3">
        Update User
      </h2>
      

      <!-- Form -->
      <form action="/edit/<%= users._id %>" method="post"
            class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-12 p-7">

        <!-- Name -->
        <div>
          <label class="block text-base text-slate-400 mb-3">Full Name</label>
          <input
            class="w-full px-6 py-5 rounded-2xl bg-slate-950/70
                   border border-slate-700 text-lg
                   focus:outline-none focus:ring-2 focus:ring-indigo-500"
            type="text"
            name="name"
            value="<%= users.name %>"
          />
        </div>

        <!-- Email -->
        <div>
          <label class="block text-base text-slate-400 mb-3">Email Address</label>
          <input
            class="w-full px-6 py-5 rounded-2xl bg-slate-950/70
                   border border-slate-700 text-lg
                   focus:outline-none focus:ring-2 focus:ring-indigo-500"
            type="text"
            name="email"
            value="<%= users.email %>"
          />
        </div>

        <!-- Image (full width) -->
        <div class="md:col-span-2">
          <label class="block text-base text-slate-400 mb-3">
            Profile Image URL
          </label>
          <input
            class="w-full px-6 py-5 rounded-2xl bg-slate-950/70
                   border border-slate-700 text-lg
                   focus:outline-none focus:ring-2 focus:ring-indigo-500"
            type="text"
            name="image"
            value="<%= users.image %>"
          />
        </div>

        <!-- Submit -->
        <div class="md:col-span-2 pt-8">
          <button
            type="submit"
            class="w-full py-5 text-xl font-medium rounded-2xl
                   bg-gradient-to-r from-yellow-400 to-amber-500
                   hover:from-yellow-500 hover:to-amber-600
                   transition shadow-xl">
            Update User
          </button>
        </div>

      </form>

    </div>

  </main>

</body>
</html>
