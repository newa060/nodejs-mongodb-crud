<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In</title>

  <link rel="stylesheet" href="./stylesheets/style.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-br from-slate-900 via-zinc-900 to-slate-800 min-h-screen
             text-white flex items-center justify-center">

  <!-- Sign In Card -->
  <div class="w-full max-w-2xl bg-zinc-900/80 backdrop-blur-xl
              rounded-[2.5rem] p-16 shadow-2xl border border-white/5">

    <h3 class="text-4xl font-semibold mb-3">
      Welcome Back
    </h3>
    <p class="text-slate-400 mb-14 text-lg">
      Log in to continue to your dashboard
    </p>

    <form action="/signin" method="post" class="space-y-10">

      <!-- Email -->
      <div>
        <label class="block text-base text-slate-400 mb-3">Email Address</label>
        <input
          class="w-full px-6 py-5 rounded-2xl bg-slate-950/70
                 border border-slate-700 text-lg
                 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          type="email"
          name="email"
          placeholder="you@example.com"
        />
      </div>

      <!-- Password -->
      <div>
        <label class="block text-base text-slate-400 mb-3">Password</label>
        <input
          class="w-full px-6 py-5 rounded-2xl bg-slate-950/70
                 border border-slate-700 text-lg
                 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          type="password"
          name="password"
          placeholder="••••••••"
        />
      </div>

      <!-- Button -->
      <button type="submit"
  class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-lg transition duration-300">
  Sign In
</button>

    </form>

  </div>

</body>
</html>
