<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign Up</title>

  <link rel="stylesheet" href="./stylesheets/style.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-br from-slate-900 via-zinc-900 to-slate-800 min-h-screen text-white flex items-center justify-center">

  <!-- Signup Card -->
  <div class="w-full max-w-2xl bg-zinc-900/80 backdrop-blur-xl
              rounded-[2.5rem] p-16 shadow-2xl border border-white/5">

    <h3 class="text-4xl font-semibold mb-3">
      Create Your Account
    </h3>
    <p class="text-slate-400 mb-14 text-lg">
      Sign up to get started with the platform
    </p>

    <form action="/signup" method="post" class="space-y-10">

      <!-- Email -->
      <div>
        <label class="block text-base text-slate-400 mb-3">Email Address</label>
        <input
          class="w-full px-6 py-5 rounded-2xl bg-slate-950/70
                 border border-slate-700 text-lg
                 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          type="email"
          name="email"
          placeholder="you@example.com"
        />
      </div>

      <!-- Password -->
      <div>
        <label class="block text-base text-slate-400 mb-3">Password</label>
        <input
          class="w-full px-6 py-5 rounded-2xl bg-slate-950/70
                 border border-slate-700 text-lg
                 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          type="password"
          name="password"
          placeholder="••••••••"
        />
      </div>

      <!-- Button -->
      <button
        type="submit"
        class="w-full py-5 text-xl font-medium rounded-2xl
               bg-gradient-to-r from-indigo-500 to-violet-500
               hover:from-indigo-600 hover:to-violet-600
               transition shadow-xl">
        Sign Up
      </button>

    </form>

  </div>

</body>
</html>
